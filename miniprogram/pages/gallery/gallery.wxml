<view class="page">

  <view class="gh-head">
    <view class="brand">科研灵感卡</view>
    <view class="brand-sub">78 张科研方法论卡片</view>
  </view>

  <!-- 今日一句：按日期固定轮播，同一天所有人相同 -->
  <view class="daily" bindtap="openDaily">
    <view class="d-top">
      <text class="d-lb">今日一句</text>
      <text class="d-date">{{today}}</text>
    </view>
    <view class="d-txt">{{daily.quote || daily.name}}</view>
    <view class="d-nm">—— {{daily.name}}{{daily.scene ? ' · ' + daily.scene : ''}}</view>
  </view>

  <view class="gh-actions">
    <view class="gh-btn accent" bindtap="checkResult">
      <text class="ico">📬</text>
      <text>查收 Result</text>
    </view>
    <view class="gh-btn ghost" bindtap="goThree">
      <text class="ico">🧭</text>
      <text>我该怎么做</text>
    </view>
    <view class="gh-btn ghost" bindtap="goAbout">
      <text class="ico">📄</text>
      <text>关于</text>
    </view>
  </view>

  <scroll-view class="tabs" scroll-x>
    <view class="tab {{curGroup === item.key ? 'on' : ''}}" wx:for="{{groups}}" wx:key="key"
          data-k="{{item.key}}" bindtap="switchGroup">{{item.label}}</view>
  </scroll-view>

  <view class="collect-bar">已读 {{collected}} / 78 张　·　翻过的卡会标成已读</view>

  <view class="grid">
    <view class="mini {{item.owned ? '' : 'dim'}}" wx:for="{{list}}" wx:key="id" data-i="{{index}}" bindtap="openSheet">
      <image class="thumb" src="{{imgBase}}{{item.img}}" mode="aspectFill" lazy-load></image>
      <view class="n">{{item.name}}</view>
      <view class="a">{{item.sub}}</view>
      <view class="own" wx:if="{{item.owned}}">已读</view>
    </view>
  </view>

  <view class="hint">内容为通用科研经验整理<br/>不构成针对个人的判断</view>

  <!-- 查收 Result：投稿结果信封彩蛋，拆开是一张通用建议卡 -->
  <view class="mask" wx:if="{{mail}}" bindtap="closeMail">
    <view class="mailcard" catchtap="noop">
      <view class="m-stamp">📮</view>
      <view class="m-t">Submission Status · Editorial Office</view>
      <view class="m-line">Dear Researcher,</view>
      <view class="m-line">We are pleased to inform you that</view>
      <view class="m-accept">your submission has been</view>
      <view class="m-accept big">ACCEPTED 🎉</view>
      <view class="m-note">（编辑部附言：随信附上一张科研建议卡，请查收）</view>
      <view class="m-btn" bindtap="openMailCard">拆 开 看 看</view>
    </view>
  </view>

  <view class="mask" wx:if="{{cur}}" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sh-head">
        <view class="t">{{cur.roman}} · {{cur.name}}</view>
        <view class="c" bindtap="closeSheet">✕</view>
      </view>

      <view class="sh-hero">
        <image src="{{imgBase}}{{cur.img}}" mode="aspectFit"></image>
        <view class="meta">
          <view class="e">{{cur.emoji}}</view>
          <view class="n">{{cur.en}}</view>
          <view class="sc" wx:if="{{cur.scene}}">{{cur.scene}}</view>
          <view class="k">{{cur.kw}}</view>
          <view class="en">{{cur.arcana === 'major' ? '主牌 · 22 张' : cur.element}}</view>
        </view>
      </view>

      <view class="sh-line quote" wx:if="{{cur.quote}}">
        <view class="v">{{cur.quote}}</view>
      </view>
      <view class="sh-line">
        <view class="k">这 条 建 议</view>
        <view class="v up">{{cur.upright}}</view>
      </view>
      <view class="sh-line">
        <view class="k">换 个 角 度 看</view>
        <view class="v down">{{cur.revText}}</view>
      </view>
      <view class="sh-line rs">
        <view class="k">科 研 场 景</view>
        <view class="v">{{cur.research}}</view>
      </view>
      <view class="sh-line">
        <view class="k">行 动 建 议</view>
        <view class="v">{{cur.advice}}</view>
      </view>

      <view class="sh-foot">
        <view class="sh-btn" bindtap="checkResult">再收一封 Result</view>
      </view>
    </view>
  </view>
</view>
