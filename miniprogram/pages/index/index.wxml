<view class="page">
  <view class="brand">今日科研卡</view>
  <view class="brand-sub">78 张科研提示卡</view>
  <view class="brand-en">R E S E A R C H　C A R D</view>

  <view class="btn" bindtap="goSingle">
    <view class="ico">🃏</view>
    <view>
      <view class="t">今日一卡</view>
      <view class="d">{{todayText}}</view>
    </view>
  </view>

  <view class="btn" bindtap="goThree">
    <view class="ico">🎴</view>
    <view>
      <view class="t">三卡组合</view>
      <view class="d">现状 · 卡点 · 下一步 · 全 78 张牌池</view>
    </view>
  </view>

  <view class="btn ghost" bindtap="goGallery">
    <view class="ico">📖</view>
    <view>
      <view class="t">卡牌图鉴</view>
      <view class="d">78 张完整牌库 · 已收集 {{collected}}/78</view>
    </view>
  </view>

  <view class="hint">内容仅供娱乐与自我调侃<br/>不构成任何学术或职业建议</view>

  <view class="foot" bindtap="goAbout">关于本卡 · 免责声明</view>
</view>
